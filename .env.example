# subtitle-studio — secrets and machine-specific settings
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#     cp .env.example .env
#
# The code reads these from the ENVIRONMENT, so load the file before running:
#     set -a; . ./.env; set +a
#     uv run subtitle-studio ...
#
# (Or export HF_TOKEN in your shell profile instead — .env is a convenience,
# not a requirement.)

# ---------------------------------------------------------------------------
# REQUIRED for speaker diarization
# ---------------------------------------------------------------------------
# pyannote's models are GATED: you must accept the terms on Hugging Face once,
# then supply a read token. Diarization is the only stage that needs it —
# transcription, translation and rendering all work without.
#
#   1. https://huggingface.co/pyannote/speaker-diarization-3.1  -> accept
#   2. https://huggingface.co/pyannote/segmentation-3.0         -> accept
#   3. https://huggingface.co/settings/tokens                   -> create (read)
#
# A "read" token is sufficient. Never use a "write" token here.
HF_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL — paths
# ---------------------------------------------------------------------------
# Where models are cached. Defaults to ~/.cache/subtitle-studio/models.
# XDG_CACHE_HOME=

# Where config.toml is read from. Defaults to ~/.config/subtitle-studio.
# XDG_CONFIG_HOME=
